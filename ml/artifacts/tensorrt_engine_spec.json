{
  "model_name": "PharmaEdgeNet-v2",
  "input_shape": [
    1,
    3,
    128,
    128
  ],
  "classes": [
    "CLEAN",
    "CRUSHED_CORNER",
    "TAPE_BREACH",
    "LABEL_OBSCURED",
    "MISSING_ICE_PACK"
  ],
  "quantization_engine": "qnnpack",
  "target_edge_hardware": [
    "NVIDIA Jetson Orin Nano",
    "Apple Silicon Edge Gateway",
    "Intel OpenVINO IPC"
  ],
  "tensorrt_build_flags": [
    "--onnx=pharma_edge_fp32.onnx",
    "--saveEngine=pharma_edge_fp16_int8.engine",
    "--int8",
    "--fp16",
    "--workspace=1024"
  ],
  "artifacts": {
    "fp32_torchscript": "ml/artifacts/pharma_edge_fp32.pt",
    "int8_torchscript": "ml/artifacts/pharma_edge_int8.pt"
  },
  "sla_target_ms": 15.0,
  "sla_met": true
}